# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Python
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/

# Prebuilt LibreOfficeKit .so binaries (>100 MB exceeds GitHub file limit; fetched/verified via scripts/fetch_lok_prebuilt.sh)
engine/office/src/main/jniLibs/**/*.so
engine/office/src/main/assets/program/
engine/office/src/main/assets/share/
engine/office/src/main/assets/unpack/

# Local-only competitor data, temp assets, and throwaway spikes (see CLAUDE.md)
.local/
scratch/
notes/

# Competitor binaries and decompiled output never enter the repo
*.apk
*.apks
*.xapk
*.aab
decompiled/

# Android / Gradle
.gradle/
.kotlin/
build/
local.properties
.idea/
*.iml
captures/
.cxx/
.externalNativeBuild/

# Secrets & signing
.env
.env.*
!.env.example
*.jks
*.keystore
*.pem
*.key
keystore.properties
signing.properties

# Claude Code local settings and lane worktrees (each worktree is a checkout of this repo)
.claude/settings.local.json
.claude/worktrees/
.mcp.json

# Logs & temp
*.log
logs/
*.tmp
*.temp
.cache/
